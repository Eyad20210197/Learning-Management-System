enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum OneTimeTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("one_time_token_type")
}

model User {
  id                 String           @id @default(uuid(7)) @db.Uuid
  email              String           @unique
  passwordHash       String           @map("password_hash")
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  status             UserStatus       @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles              UserRole[]
  devices            Device[]
  sessions           AuthSession[]
  oneTimeTokens      OneTimeToken[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  idempotencyKeys    IdempotencyKey[]
  enrollments        Enrollment[]     @relation("StudentEnrollments")
  grantedEnrollments Enrollment[]     @relation("GrantedEnrollments")
  lessonProgress     LessonProgress[]
  initiatedVideoUploads VideoUpload[]
  initiatedLessonResources LessonResource[]
  playbackSessions  PlaybackSession[]

  @@index([status, createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Device {
  id               String          @id @default(uuid(7)) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  clientDeviceUuid String          @map("client_device_uuid") @db.Uuid
  name             String
  browser          String?
  operatingSystem  String?         @map("operating_system")
  userAgent        String?         @map("user_agent")
  firstSeenAt      DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt       DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions         AuthSession[]
  securityEvents   SecurityEvent[]
  playbackSessions PlaybackSession[]

  @@unique([userId, clientDeviceUuid])
  @@index([userId, revokedAt])
  @@map("devices")
}

model AuthSession {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceId      String         @map("device_id") @db.Uuid
  ipAddress     String?        @map("ip_address") @db.Inet
  userAgent     String?        @map("user_agent")
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?        @map("revoke_reason")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  playbackSessions PlaybackSession[]

  @@index([userId, revokedAt])
  @@index([deviceId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id            String         @id @default(uuid(7)) @db.Uuid
  sessionId     String         @map("session_id") @db.Uuid
  tokenHash     String         @unique @map("token_hash")
  parentTokenId String?        @map("parent_token_id") @db.Uuid
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?      @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session       AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  parent        RefreshToken?  @relation("RefreshTokenFamily", fields: [parentTokenId], references: [id], onDelete: Restrict)
  children      RefreshToken[] @relation("RefreshTokenFamily")

  @@index([sessionId, expiresAt])
  @@index([parentTokenId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       OneTimeTokenType
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
  @@map("one_time_tokens")
}
