{
  "name": "@lms/backend",
  "version": "0.1.0",
  "description": "LMS API and background worker modular monolith",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "npm run prisma:generate && nest build api && nest build video-worker",
    "build:api": "npm run prisma:generate && nest build api",
    "build:worker": "npm run prisma:generate && nest build video-worker",
    "typecheck": "npm run prisma:generate && tsc --noEmit --incremental false",
    "format": "prettier --write \"{apps,libs,prisma}/**/*.{ts,json}\" \"*.{ts,mjs,json,md}\" \"../compose.yaml\"",
    "format:check": "prettier --check \"{apps,libs,prisma}/**/*.{ts,json}\" \"*.{ts,mjs,json,md}\" \"../compose.yaml\"",
    "lint": "eslint \"{apps,libs,prisma}/**/*.ts\" \"*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "start": "npm run start:api",
    "start:api": "nest start api",
    "start:api:dev": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:worker": "nest start video-worker",
    "start:worker:dev": "nest start video-worker --watch",
    "start:prod:api": "node dist/apps/api/main.js",
    "start:prod:worker": "node dist/apps/video-worker/main.js",
    "test": "npm run prisma:generate && jest --runInBand",
    "test:watch": "npm run prisma:generate && jest --watch",
    "test:cov": "npm run prisma:generate && jest --coverage --runInBand",
    "test:debug": "npm run prisma:generate && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run prisma:generate && jest --config ./apps/api/test/jest-e2e.json --runInBand",
    "contracts:lint": "redocly lint ../docs/openapi.yaml && dbml2sql ../docs/erd.dbml --postgres --out-file .contract-schema.sql && node -e \"require('node:fs').rmSync('.contract-schema.sql')\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:create-owner": "tsx prisma/create-owner.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker compose --env-file .env -f ../compose.yaml up -d --wait postgres redis object-storage",
    "infra:down": "docker compose --env-file .env -f ../compose.yaml down",
    "infra:logs": "docker compose --env-file .env -f ../compose.yaml logs -f postgres redis object-storage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "bullmq": "6.0.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "file-type": "22.0.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "joi": "18.2.3",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@dbml/cli": "9.1.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.29",
    "@redocly/cli": "2.46.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@lms/identity(|/.*)$": "<rootDir>/libs/identity/src/$1",
      "^@lms/learning(|/.*)$": "<rootDir>/libs/learning/src/$1",
      "^@lms/media(|/.*)$": "<rootDir>/libs/media/src/$1",
      "^@lms/operations(|/.*)$": "<rootDir>/libs/operations/src/$1",
      "^@lms/platform(|/.*)$": "<rootDir>/libs/platform/src/$1",
      "^@lms/shared-kernel(|/.*)$": "<rootDir>/libs/shared-kernel/src/$1"
    }
  }
}
